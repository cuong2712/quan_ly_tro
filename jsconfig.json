{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["quan-ly-phong-tro/src/*"]
    }
  },
  "include": [
    "quan-ly-phong-tro/src/**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "smartrent-api/**"
  ]
}
